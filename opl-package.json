{
  "schema_version": "opl.package.v2",
  "identity": {
    "id": "agent-session-vault",
    "version": "0.1.7",
    "intent": "extension",
    "name": {
      "zh-CN": "OPL Session Vault",
      "en-US": "OPL Session Vault"
    },
    "summary": {
      "zh-CN": "同步 Agent 会话统计，管理用量分析与可恢复的 Codex 归档。",
      "en-US": "Session synchronization, usage analytics, and recoverable Codex archives."
    },
    "routing_summary": {
      "zh-CN": "通过 Vault 查看会话统计、同步获准的 Fleet 投影并审阅归档计划。",
      "en-US": "Inspect session analytics, synchronize approved Fleet projections, and review archive plans through the Vault owner."
    },
    "publisher": "gaofeng21cn",
    "license": "Apache-2.0",
    "icon": "assets/branding/agent-session-vault-logo.png",
    "repository": "https://github.com/gaofeng21cn/agent-session-vault"
  },
  "dependencies": {
    "opl_base": "^2.0.0"
  },
  "provides": {
    "skills": [
      {
        "id": "agent-session-vault",
        "path": "./skills/agent-session-vault",
        "exposure": "default"
      }
    ],
    "module_ids": [
      "agent.session.vault.v1"
    ],
    "contribution_handler": {
      "kind": "cli",
      "argv": [
        "python3",
        "./app_contribution.py"
      ],
      "transport": "stdin_json_stdout_json"
    }
  },
  "ui": {
    "declarative": {
      "views": [
        {
          "id": "vault.runtime.status",
          "view_type": "service_status",
          "slot": "settings.section",
          "settings_destination": "services",
          "title": {
            "zh-CN": "运行依赖",
            "en-US": "Runtime prerequisites"
          },
          "data_ref": "agent.session.vault.v1#status",
          "sort_order": 690
        },
        {
          "id": "vault.archive.review",
          "view_type": "list_detail",
          "slot": "settings.section",
          "settings_destination": "services",
          "title": {
            "zh-CN": "归档计划与结果",
            "en-US": "Archive plan and outcome"
          },
          "data_ref": "agent.session.vault.v1#review",
          "sort_order": 700
        }
      ]
    }
  },
  "distribution": {
    "oci": "ghcr.io/gaofeng21cn/one-person-lab-packages/agent-session-vault",
    "visibility": "public"
  },
  "host_hints": {
    "codex": {
      "sync_enabled": false
    }
  }
}
